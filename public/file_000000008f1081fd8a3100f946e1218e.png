<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 640" width="100%" height="100%">
  <defs>
    <!-- Background Gradients -->
    <radialGradient id="bgGrad" cx="50%" cy="40%" r="65%">
      <stop offset="0%" stop-color="#1A4A38" />
      <stop offset="60%" stop-color="#0B2F23" />
      <stop offset="100%" stop-color="#051B14" />
    </radialGradient>

    <!-- Warm Rim Lighting -->
    <linearGradient id="rimLight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F27D26" stop-opacity="0.6" />
      <stop offset="50%" stop-color="#FBBF24" stop-opacity="0.2" />
      <stop offset="100%" stop-color="#051B14" stop-opacity="0" />
    </linearGradient>

    <!-- Skin Tone Gradients -->
    <linearGradient id="skinGrad" x1="30%" y1="0%" x2="70%" y2="100%">
      <stop offset="0%" stop-color="#E2B18E" />
      <stop offset="45%" stop-color="#D59B73" />
      <stop offset="85%" stop-color="#C0845B" />
      <stop offset="100%" stop-color="#A56A43" />
    </linearGradient>

    <linearGradient id="skinShadow" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#B8774D" stop-opacity="0" />
      <stop offset="100%" stop-color="#8F532D" stop-opacity="0.7" />
    </linearGradient>

    <linearGradient id="skinHighlight" x1="0%" y1="0%" x2="100%" y2="50%">
      <stop offset="0%" stop-color="#F3CCA9" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#E2B18E" stop-opacity="0" />
    </linearGradient>

    <!-- Hair Gradient -->
    <linearGradient id="hairGrad" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#2D2826" />
      <stop offset="40%" stop-color="#1A1817" />
      <stop offset="100%" stop-color="#0C0A09" />
    </linearGradient>

    <!-- Beard Texture/Gradient -->
    <linearGradient id="beardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#262220" stop-opacity="0.8" />
      <stop offset="60%" stop-color="#141211" stop-opacity="0.95" />
      <stop offset="100%" stop-color="#0C0A09" />
    </linearGradient>

    <!-- Coat Gradients -->
    <linearGradient id="coatGrad" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#1E293B" />
      <stop offset="50%" stop-color="#0F172A" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>

    <linearGradient id="collarGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="70%" stop-color="#E2E8F0" />
      <stop offset="100%" stop-color="#CBD5E1" />
    </linearGradient>

    <!-- Glasses Frame Gradient -->
    <linearGradient id="glassesGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#383838" />
      <stop offset="50%" stop-color="#1A1A1A" />
      <stop offset="100%" stop-color="#0D0D0D" />
    </linearGradient>

    <!-- Glasses Lens Glare -->
    <linearGradient id="lensGlare" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.25" />
      <stop offset="40%" stop-color="#60A5FA" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.02" />
    </linearGradient>

    <!-- Soft Vignette Shadow -->
    <filter id="softBlur" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="4" />
    </filter>

    <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#000000" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Background Canvas -->
  <rect width="480" height="640" fill="url(#bgGrad)" />
  <rect width="480" height="640" fill="url(#rimLight)" />

  <!-- Subtle Forest Depth Elements -->
  <circle cx="80" cy="120" r="140" fill="#2A6B53" opacity="0.15" filter="url(#softBlur)" />
  <circle cx="420" cy="480" r="180" fill="#F27D26" opacity="0.1" filter="url(#softBlur)" />

  <!-- Shoulders & Coat Body -->
  <g id="body" filter="url(#dropShadow)">
    <!-- Base Coat Silhouette -->
    <path d="M 40 640 L 40 520 C 40 460 90 410 160 395 L 200 450 L 240 480 L 280 450 L 320 395 C 390 410 440 460 440 520 L 440 640 Z" fill="url(#coatGrad)" />
    
    <!-- Coat Lapels -->
    <path d="M 160 395 L 210 540 L 240 580 L 200 450 Z" fill="#1E293B" stroke="#334155" stroke-width="1" />
    <path d="M 320 395 L 270 540 L 240 580 L 280 450 Z" fill="#0F172A" stroke="#1E293B" stroke-width="1" />

    <!-- Inner Shirt & Collar -->
    <path d="M 205 380 L 240 445 L 275 380 L 260 360 L 240 370 L 220 360 Z" fill="url(#collarGrad)" stroke="#CBD5E1" stroke-width="1.5" />
    <path d="M 240 445 L 240 580" stroke="#94A3B8" stroke-width="1.5" />

    <!-- Valmiki Gold Pin -->
    <circle cx="175" cy="465" r="7" fill="#F59E0B" stroke="#FBBF24" stroke-width="1" />
    <polygon points="175,461 177,464 180,465 177,466 175,469 173,466 170,465 173,464" fill="#78350F" />
  </g>

  <!-- Neck & Shadow -->
  <g id="neck">
    <path d="M 200 320 L 200 390 C 200 415 280 415 280 390 L 280 320 Z" fill="url(#skinGrad)" />
    <!-- Neck shadow under chin -->
    <path d="M 195 320 C 220 355 260 355 285 320 L 280 355 C 260 380 220 380 200 355 Z" fill="#884C27" opacity="0.6" />
  </g>

  <!-- Head & Face Structure -->
  <g id="head" filter="url(#dropShadow)">
    <!-- Ears -->
    <!-- Left Ear -->
    <path d="M 145 220 C 135 220 130 245 135 265 C 140 280 150 285 155 275 Z" fill="#C98860" stroke="#A8653F" stroke-width="1" />
    <path d="M 142 235 C 138 245 140 260 148 265" fill="none" stroke="#8E4F28" stroke-width="2" stroke-linecap="round" />
    
    <!-- Right Ear -->
    <path d="M 335 220 C 345 220 350 245 345 265 C 340 280 330 285 325 275 Z" fill="#C98860" stroke="#A8653F" stroke-width="1" />
    <path d="M 338 235 C 342 245 340 260 332 265" fill="none" stroke="#8E4F28" stroke-width="2" stroke-linecap="round" />

    <!-- Face Base -->
    <path d="M 152 180 C 152 110 328 110 328 180 C 328 230 325 295 295 330 C 265 360 215 360 185 330 C 155 295 152 230 152 180 Z" fill="url(#skinGrad)" />

    <!-- Cheeks & Facial Highlights -->
    <path d="M 160 190 C 160 150 240 140 240 190 C 240 230 180 240 160 190 Z" fill="url(#skinHighlight)" opacity="0.4" />
    <path d="M 320 190 C 320 150 240 140 240 190 C 240 230 300 240 320 190 Z" fill="url(#skinHighlight)" opacity="0.2" />

    <!-- Hair (Back/Top/Sides) -->
    <path d="M 140 185 C 138 120 170 70 240 65 C 310 70 342 120 340 185 C 340 200 335 210 330 210 C 325 180 325 130 285 110 C 240 90 190 115 160 145 C 150 160 148 190 145 210 C 142 210 140 200 140 185 Z" fill="url(#hairGrad)" />
    
    <!-- Hair Texture Strands -->
    <path d="M 165 140 C 200 95 260 85 305 105" fill="none" stroke="#3D3530" stroke-width="3" stroke-linecap="round" opacity="0.7" />
    <path d="M 180 120 C 220 85 270 85 315 115" fill="none" stroke="#4B423C" stroke-width="2" stroke-linecap="round" opacity="0.5" />
    <path d="M 155 165 C 175 130 215 110 255 105" fill="none" stroke="#2D2826" stroke-width="2.5" stroke-linecap="round" />

    <!-- Eyebrows -->
    <!-- Left Eyebrow -->
    <path d="M 175 198 C 190 190 210 192 225 198 C 215 193 195 192 178 201 Z" fill="#171412" />
    <!-- Right Eyebrow -->
    <path d="M 305 198 C 290 190 270 192 255 198 C 265 193 285 192 302 201 Z" fill="#171412" />

    <!-- Eyes -->
    <!-- Left Eye -->
    <ellipse cx="202" cy="215" rx="14" ry="8" fill="#FFFFFF" />
    <ellipse cx="203" cy="215" rx="7" ry="7" fill="#3B2314" />
    <circle cx="203" cy="215" r="4" fill="#0A0705" />
    <circle cx="205" cy="213" r="1.5" fill="#FFFFFF" />
    <path d="M 188 214 C 195 208 210 208 218 214" fill="none" stroke="#261A12" stroke-width="2" stroke-linecap="round" />

    <!-- Right Eye -->
    <ellipse cx="278" cy="215" rx="14" ry="8" fill="#FFFFFF" />
    <ellipse cx="277" cy="215" rx="7" ry="7" fill="#3B2314" />
    <circle cx="277" cy="215" r="4" fill="#0A0705" />
    <circle cx="279" cy="213" r="1.5" fill="#FFFFFF" />
    <path d="M 262 214 C 270 208 285 208 292 214" fill="none" stroke="#261A12" stroke-width="2" stroke-linecap="round" />

    <!-- Nose -->
    <path d="M 240 195 L 236 248 C 230 252 226 256 228 260 C 232 264 248 264 252 260 C 254 256 250 252 244 248 Z" fill="#C58155" />
    <!-- Nostrils -->
    <ellipse cx="233" cy="258" rx="2.5" ry="1.5" fill="#6A3B1D" />
    <ellipse cx="247" cy="258" rx="2.5" ry="1.5" fill="#6A3B1D" />
    <path d="M 238 220 L 238 250" stroke="#F1C2A0" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />

    <!-- Mustache & Beard -->
    <g id="beard">
      <!-- Mustache -->
      <path d="M 224 275 C 234 270 246 270 256 275 C 262 278 266 284 262 287 C 252 284 246 280 240 281 C 234 280 228 284 218 287 C 214 284 218 278 224 275 Z" fill="url(#beardGrad)" />

      <!-- Lips / Gentle Smile -->
      <path d="M 222 288 C 232 296 248 296 258 288" fill="none" stroke="#87472A" stroke-width="2" stroke-linecap="round" />
      <path d="M 225 289 C 235 298 245 298 255 289 C 248 292 232 292 225 289 Z" fill="#9C5333" />
      <!-- Teeth Hint -->
      <path d="M 232 290 Q 240 293 248 290 Q 240 291 232 290" fill="#FFFFFF" opacity="0.9" />

      <!-- Beard on Jawline & Chin -->
      <path d="M 154 235 C 154 280 170 340 240 348 C 310 340 326 280 326 235 C 326 255 315 320 285 338 C 255 352 225 352 195 338 C 165 320 154 255 154 235 Z" fill="url(#beardGrad)" />
      <!-- Soul Patch -->
      <path d="M 236 296 L 244 296 L 242 308 L 238 308 Z" fill="#1C1816" />
    </g>

    <!-- Spectacles / Glasses (Modern Stylish Rectangular/Round Dark Frames) -->
    <g id="glasses">
      <!-- Bridge -->
      <path d="M 224 213 Q 240 209 256 213" fill="none" stroke="url(#glassesGrad)" stroke-width="4.5" stroke-linecap="round" />
      <path d="M 226 213 Q 240 210 254 213" fill="none" stroke="#4A4A4A" stroke-width="1.5" stroke-linecap="round" />

      <!-- Left Lens Frame -->
      <rect x="170" y="196" width="55" height="38" rx="10" ry="10" fill="url(#lensGlare)" stroke="url(#glassesGrad)" stroke-width="4.5" />
      <!-- Left Lens Glare Highlight -->
      <path d="M 174 200 L 210 200 C 195 212 180 226 174 228 Z" fill="#FFFFFF" opacity="0.12" />

      <!-- Right Lens Frame -->
      <rect x="255" y="196" width="55" height="38" rx="10" ry="10" fill="url(#lensGlare)" stroke="url(#glassesGrad)" stroke-width="4.5" />
      <!-- Right Lens Glare Highlight -->
      <path d="M 259 200 L 295 200 C 280 212 265 226 259 228 Z" fill="#FFFFFF" opacity="0.12" />

      <!-- Temple Arms -->
      <path d="M 170 210 L 146 220" stroke="url(#glassesGrad)" stroke-width="4" stroke-linecap="round" />
      <path d="M 310 210 L 334 220" stroke="url(#glassesGrad)" stroke-width="4" stroke-linecap="round" />
    </g>
  </g>

  <!-- Bottom Conservation Label / Watermark Badge -->
  <g id="badge" transform="translate(240, 605)">
    <rect x="-110" y="-16" width="220" height="26" rx="13" fill="#07271D" stroke="#F59E0B" stroke-width="1" opacity="0.9" />
    <text x="0" y="2" fill="#FBBF24" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" text-anchor="middle" letter-spacing="1.5">VALMIKI TIGER WATCH</text>
  </g>
</svg>
